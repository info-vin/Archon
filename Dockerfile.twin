# 使用支援 Python 3.11 的鏡像
FROM python:3.11-slim-bookworm

WORKDIR /app

# 安裝系統依賴 (Playwright 運作所需)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxcb1 \
    libxkbcommon0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install uv for faster builds
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 🟢 物理修正：使用 uv 並行安裝，對齊 0413 官方 SDK 標準
RUN uv pip install --system --no-cache playwright google-genai python-dotenv supabase

# Install Playwright browsers
RUN python -m playwright install chromium
RUN python -m playwright install-deps chromium

# Copy script
COPY scripts/twin_scout.py /app/scout.py

ENTRYPOINT ["python", "/app/scout.py"]
