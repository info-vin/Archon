; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Archon Agency Tycoon"
config/description="Agency Tycoon simulator built with TDD in Godot 4."
run/main_scene="uid://b8yq7qxyxxxx"
config/features=PackedStringArray("4.6", "GL Compatibility")
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[autoload]

EventBus="*res://Scripts/Autoloads/EventBus.gd"
SimulationEngine="*res://Scripts/Logic/SimulationEngine.gd"
AudioManager="*res://Scripts/Autoloads/AudioManager.gd"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://translations.en.translation", "res://translations.ja.translation", "res://translations.zh_TW.translation")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/hdr_2d=true
